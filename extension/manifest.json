{
  "manifest_version": 3,
  "name": "雲端藥歷整理小幫手",
  "version": "1.3.0",
  "description": "彙整健保雲端用藥、檢驗、影像病理、手術、出院病摘與過敏紀錄，供核對後貼入病歷（不連外、不自動上傳）。",
  "content_scripts": [
    {
      "matches": ["https://medcloud2.nhi.gov.tw/imu/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}
